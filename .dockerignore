# Secrets — MUST never end up in the image
.env
.env.local
.env.production
*.env
!.env.example
deployment_keys/
secrets/
*.pem
*.key
id_rsa
id_rsa.pub

# Server-specific configs (may contain IPs/credentials)
nginx-deployes.conf
start-deployes.sh

# VCS
.git
.gitignore

# Dependencies and build output (rebuilt inside the image)
node_modules/
web/node_modules/
web/dist/
web/.angular/
web/.cache/
dist/
bin/
uploads/

# Binaries
*.exe
*.dll
*.so
*.dylib
api.exe

# Test coverage
coverage.out
coverage.html
*.coverprofile

# Docs and tooling not needed at build time
README.md
README.tr.md
CONTRIBUTING.md
LICENSE
Makefile
.golangci.yml
.pre-commit-config.yaml
.github/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db

# Temp and backup files
*~
*.bak
*.tmp
