# ===========================================
# deployes - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit real secrets to git!
# ===========================================

# Database
POSTGRES_USER=deployes
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here
POSTGRES_DB=deployes

# Connection string used by the app.
#
#   docker compose  -> host MUST be the service name "postgres"
#   go run / make run (Postgres on the host) -> host is "localhost"
#
# The password here must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://deployes:CHANGE_ME_secure_password_here@postgres:5432/deployes?sslmode=disable

# JWT Authentication (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_random_32_char_key

# Encryption Key (exactly 32 characters for AES-256)
# Encrypts stored SSH keys — losing or changing this makes saved servers unusable.
ENCRYPTION_KEY=CHANGE_ME_exactly_32_chars_long!

# Server
APP_PORT=8080

# Public URL of this instance. Used to build the git webhook URLs handed out to
# GitHub/GitLab, so localhost will NOT work in production.
BASE_URL=https://deployes.example.com

# CORS Allowed Origins (comma-separated)
# In production this is the same origin as BASE_URL (the Angular app is served
# by the Go API). Add http://localhost:4200 only when running `ng serve`.
ALLOWED_ORIGINS=https://deployes.example.com
